# Copy needed values into ignored backend/config.env. Never commit real credentials.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE
# Required: a securely generated random secret of at least 32 bytes. No built-in fallback.
AUTH_SECRET_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

PAYMENT_TEST_MODE=true
IYZIPAY_API_KEY=
IYZIPAY_SECRET_KEY=
IYZIPAY_BASE_URL=https://sandbox-api.iyzipay.com
